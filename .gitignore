# Binaries
bin/
*.exe
*.test

# Go
vendor/
coverage.out

# Node
node_modules/
dist/
.vite/

# Env / secrets
.env
.env.*
!.env.example
*.tfvars
!*.tfvars.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*
# Not committed on purpose: a lock file records which registry the providers
# came from, so one written by OpenTofu names registry.opentofu.org and breaks
# `terraform init` for anyone using Terraform, and the reverse.
.terraform.lock.hcl

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Workspace data
/tmp/
/data/
