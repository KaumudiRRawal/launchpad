# Copy to .env for local development.
LAUNCHPAD_ENV=development
LAUNCHPAD_HTTP_ADDR=:8080
LAUNCHPAD_DATABASE_URL=postgres://launchpad:launchpad@localhost:5432/launchpad?sslmode=disable
LAUNCHPAD_LOG_LEVEL=debug

# Where deployments run. "docker" needs nothing but a local daemon; "cloudrun"
# additionally requires LAUNCHPAD_GCP_PROJECT and LAUNCHPAD_GCP_REGION, and the
# process refuses to start without them.
LAUNCHPAD_DEPLOY_DRIVER=docker
# LAUNCHPAD_GCP_PROJECT=launchpad-prod
# LAUNCHPAD_GCP_REGION=europe-west1
# LAUNCHPAD_ARTIFACT_REPOSITORY=launchpad
# LAUNCHPAD_CLOUD_RUN_SERVICE_ACCOUNT=launchpad-workload@launchpad-prod.iam.gserviceaccount.com
# Deployed workloads answer through the platform proxy, which sends no identity
# token. Turn this off only when something that does sign requests is in front.
# LAUNCHPAD_CLOUD_RUN_ALLOW_UNAUTHENTICATED=true
